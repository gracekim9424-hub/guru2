<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 지도와 날씨 API 통신을 위한 인터넷 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 여행 사진 촬영을 위한 카메라 권한 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 카메라가 없는 기기에서도 앱 설치 허용 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 사용자의 현재 위치 조회 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 기기 사진 선택을 위한 이미지 접근 권한 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- 앱의 기본 설정 -->
    <application
        android:name=".DamyeoomApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Damyeoom">

        <!-- 앱 실행 시 가장 먼저 열리는 메인 화면 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Damyeoom">

            <!-- 앱 아이콘 실행 설정 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 네이버 지도 Activity 등록 -->
        <activity
            android:name="com.team.travelmap.MapActivity"
            android:exported="false"
            android:theme="@style/Theme.Damyeoom" />

        <!-- 지도에서 선택한 위치를 전달받는 기록 Activity -->
        <activity
            android:name="com.team.travelmap.RecordActivity"
            android:exported="false"
            android:theme="@style/Theme.Damyeoom" />

        <!-- 카메라로 촬영한 파일을 앱에서 안전하게 공유 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <!-- 공유 가능한 파일 경로 설정 -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>